# Variables de entorno OPCIONALES reconocidas por los scripts.
# Los scripts NO cargan este archivo automáticamente: defínalas en la sesión, p. ej.:
#   PowerShell:  $env:VSCODE_PROGRAMS_DIR = 'D:\Programs'
#   CMD:         set VSCODE_PROGRAMS_DIR=D:\Programs
# La ruta resultante no debe contener espacios.
VSCODE_PROGRAMS_DIR=C:\Programs
VSCODE_APP_FOLDER=VSCode
